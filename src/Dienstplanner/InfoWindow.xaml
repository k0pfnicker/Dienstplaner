<Window x:Class="Dienstplanner.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Information &amp; Hilfe" Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9F9F9">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
        <StackPanel>
            <TextBlock Text="Dienstplaner Übersicht" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <TextBlock Text="Wie werden die Zeiten berechnet?" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBlock Text="Die folgenden eingetragenen Kürzel werden automatisch aus der Word-Tabelle als tatsächliche Arbeitszeiten interpretiert:" TextWrapping="Wrap"/>
            
            <Grid Margin="10,5,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="T" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="16:00 - 21:00 Uhr"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="T1" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="07:30 - 14:00 Uhr"/>
                
                <TextBlock Grid.Row="2" Grid.Column="0" Text="T2" FontWeight="Bold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="14:00 - 21:00 Uhr"/>
                
                <TextBlock Grid.Row="3" Grid.Column="0" Text="N" FontWeight="Bold"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="21:00 - 08:30 Uhr (Nachtschicht)" TextWrapping="Wrap"/>
                
                <TextBlock Grid.Row="4" Grid.Column="1" Text="💡 Ausnahme: An normalen Sonntagen (wenn der folgende Montag kein planmäßiger Feiertag ist) endet diese Schicht bereits um 08:15 Uhr." FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,5" Foreground="#555"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="K" FontWeight="Bold" Foreground="#E65100"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="Krankheit" Foreground="#E65100"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="U" FontWeight="Bold" Foreground="#0D47A1"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="Urlaub" Foreground="#0D47A1"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="X" FontWeight="Bold" Foreground="#00930a"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="Freistellung / Frei (Antrag)" Foreground="#00930a"/>
            </Grid>

            <Separator Margin="0,10"/>

            <TextBlock Text="Farbliche Markierungen &amp; Hinweise" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,5"/>
            
            <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
                <Border BorderBrush="#FFB300" BorderThickness="2" Width="14" Height="14" Margin="0,0,5,0"/>
                <TextBlock Text="Gelbe Umrandung: Zeigt den aktuell heutigen Tag." TextWrapping="Wrap" Width="380"/>
            </WrapPanel>
            
            <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
                <Rectangle Fill="#FFCDD2" Width="14" Height="14" Margin="0,0,5,0"/>
                <TextBlock Text="Rot: Ein Schicht-Kürzel konnte nicht zugeordnet werden und wird deshalb rot ('Unbekannt') markiert." TextWrapping="Wrap" Width="380"/>
            </WrapPanel>
            
            <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
                <Rectangle Fill="#EEEEEE" Width="14" Height="14" Margin="0,0,5,0"/>
                <TextBlock Text="Grau hinterlegt: Auffüll-Tage aus dem Vor-/Folgemonat. Sie dienen lediglich dazu, dass die Montags-Ausrichtung der Tabelle erhalten bleibt." TextWrapping="Wrap" Width="380"/>
            </WrapPanel>

            <Separator Margin="0,15,0,10"/>
            <Button Content="Schließen" Width="100" HorizontalAlignment="Center" Click="CloseButton_Click" Padding="5"/>
        </StackPanel>
    </ScrollViewer>
</Window>
