<Window x:Class="Dienstplaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dienstplaner"
        mc:Ignorable="d"
        Title="Dienstplaner" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <ToolBarPanel Grid.Row="0" Margin="5">
            <ToolBar>
                <Button Command="{Binding LoadCommand}">Dienstplan importieren...</Button>
                <Separator/>
                <TextBlock VerticalAlignment="Center" Margin="10,0,5,0">Person auswählen:</TextBlock>
                <ComboBox ItemsSource="{Binding AvailablePersons}" 
                          SelectedItem="{Binding SelectedPersonSchedule}"
                          DisplayMemberPath="Name" 
                          Width="200"/>
                <Separator/>
                <Button Click="InfoButton_Click" ToolTip="Erklärungen zu Zeiten und Farben">ℹ Info &amp; Hilfe</Button>
            </ToolBar>
        </ToolBarPanel>

        <!-- Main Content & Logs -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Linke Spalte (Tabelle und Log) -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                
                <DataGrid Grid.Row="0" 
                      ItemsSource="{Binding Assignments}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      AlternatingRowBackground="#f0f0f0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tag" Binding="{Binding DayOfMonthStr}"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding Date, StringFormat=\{0:dd.MM.yyyy\}}"/>
                    <DataGridTextColumn Header="Wochentag" Binding="{Binding Date, StringFormat=\{0:dddd\}, ConverterCulture=de-DE}"/>
                    <DataGridTextColumn Header="Kürzel" Binding="{Binding CodeDisplay}"/>
                    <DataGridTextColumn Header="Typ" Binding="{Binding TypeDisplay}"/>
                    <DataGridTextColumn Header="Start" Binding="{Binding StartTimeStr}"/>
                    <DataGridTextColumn Header="Ende" Binding="{Binding EndTimeStr}"/>
                    <DataGridTextColumn Header="Dauer" Binding="{Binding DurationStr}"/>
                    <DataGridTextColumn Header="Feiertag" Binding="{Binding IsHolidayDisplay}"/>
                </DataGrid.Columns>
                
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="Black" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="Frei">
                                <Setter Property="Background" Value="#F5F5F5" />
                                <Setter Property="Foreground" Value="#00930a" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Urlaub">
                                <Setter Property="Background" Value="#E3F2FD" />
                                <Setter Property="Foreground" Value="#0D47A1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Krank">
                                <Setter Property="Background" Value="#FFF3E0" />
                                <Setter Property="Foreground" Value="#E65100" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Feiertag">
                                <Setter Property="Background" Value="#FFEBEE" />
                                <Setter Property="Foreground" Value="#B71C1C" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPaddingDay}" Value="True">
                                <Setter Property="Background" Value="#EEEEEE" />
                                <Setter Property="Foreground" Value="#BDBDBD" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter Property="BorderBrush" Value="#FFB300" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Unbekannt">
                                <Setter Property="Background" Value="#FFCDD2" />
                                <Setter Property="Foreground" Value="#B71C1C" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="LightGray" Margin="0,5,0,5"/>

            <GroupBox Grid.Row="2" Header="Import-Log (Debug)">
                <TextBox Text="{Binding FullDebugLog, Mode=OneWay}" 
                         IsReadOnly="True" 
                         TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto" 
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Consolas" 
                         FontSize="11" />
            </GroupBox>
            </Grid>

            <!-- Rechte Spalte: Statistik -->
            <GroupBox Grid.Column="1" Header="Statistik">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <CheckBox Grid.Row="0" Margin="0,0,0,10"
                              IsChecked="{Binding ShowAllStatistics}"
                              Content="Für alle Personen anzeigen"/>

                    <!-- Single User Stats -->
                    <StackPanel Grid.Row="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowAllStatistics}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <TextBlock Text="{Binding SelectedPersonSchedule.Name, StringFormat='{}Name: {0}'}" FontWeight="Bold" Margin="0,0,0,10" FontSize="14" />
                        <TextBlock Text="{Binding SelectedPersonSchedule.TotalWorkHours, StringFormat='{}Arbeitsstunden: {0:F1} h'}" Margin="0,2" />
                        <TextBlock Text="{Binding SelectedPersonSchedule.UrlaubDays, StringFormat='{}Urlaub: {0} Tag(e)'}" Margin="0,2" />
                        <TextBlock Text="{Binding SelectedPersonSchedule.KrankDays, StringFormat='{}Krankheit: {0} Tag(e)'}" Margin="0,2" />
                        <TextBlock Text="{Binding SelectedPersonSchedule.FeiertagDays, StringFormat='{}Feiertage: {0} Tag(e)'}" Margin="0,2" />
                        <TextBlock Text="{Binding SelectedPersonSchedule.FreiDays, StringFormat='{}Freie Anträge / Frei: {0} Tag(e)'}" Margin="0,2" />
                    </StackPanel>

                    <!-- All Users Stats -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowAllStatistics}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding AvailablePersons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                            <Grid Margin="5,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="80"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="80"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TotalWorkHours, StringFormat='{}Std: {0:F1}h'}" FontSize="11"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UrlaubDays, StringFormat='{}Urlaub: {0}'}" FontSize="11"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding KrankDays, StringFormat='{}Krank: {0}'}" FontSize="11"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FeiertagDays, StringFormat='{}Feiertag: {0}'}" FontSize="11"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding FreiDays, StringFormat='{}Frei: {0}'}" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
